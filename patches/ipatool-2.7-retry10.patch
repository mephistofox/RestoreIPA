--- /dev/null
+++ b/pkg/appstore/restore_retry10_test.go
@@ -0,0 +1,28 @@
+package appstore
+
+import (
+	"errors"
+	apphttp "github.com/majd/ipatool/v2/pkg/http"
+	"go.uber.org/mock/gomock"
+	"testing"
+	"time"
+)
+
+func TestRestoreRetriesTenTransientFailures(t *testing.T) {
+	for _, status := range []int{204, 404, 503, 301} {
+		t.Run(string(rune(status)), func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			client := apphttp.NewMockClient[loginResult](ctrl)
+			failure := &apphttp.UnexpectedResponseError{StatusCode: status, Reason: "authentication redirect is missing Location"}
+			client.EXPECT().Send(gomock.Any()).Return(apphttp.Result[loginResult]{}, failure).Times(10)
+			sut := NewAppStore(Args{AuthenticationAttempts: 10}).(*appstore)
+			sut.loginClient = client
+			waits := 0
+			sut.authRetrySleep = func(time.Duration) { waits++ }
+			_, err := sut.sendAuthenticationRequest(apphttp.Request{})
+			if !errors.Is(err, failure) || waits != 9 {
+				t.Fatalf("expected ten sends and nine waits; err=%v waits=%d", err, waits)
+			}
+		})
+	}
+}
