--- /dev/null
+++ b/pkg/appstore/restore_auth_test.go
@@ -0,0 +1,57 @@
+package appstore
+
+import (
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	apphttp "github.com/majd/ipatool/v2/pkg/http"
+	"go.uber.org/mock/gomock"
+)
+
+func TestRestoreDoesNotAutomaticallyResubmitAuthentication(t *testing.T) {
+	for name, failure := range map[string]error{
+		"empty response": &apphttp.UnexpectedResponseError{StatusCode: 204},
+		"unavailable":    &apphttp.UnexpectedResponseError{StatusCode: 503},
+		"transport":      &apphttp.TransportError{Err: io.EOF},
+	} {
+		t.Run(name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			client := apphttp.NewMockClient[loginResult](ctrl)
+			client.EXPECT().Send(gomock.Any()).Return(apphttp.Result[loginResult]{}, failure).Times(1)
+			sut := NewAppStore(Args{DisableAuthenticationRetries: true}).(*appstore)
+			sut.loginClient = client
+			sut.authRetrySleep = func(time.Duration) { t.Fatal("Restore must not wait and retry credentials") }
+			_, err := sut.sendAuthenticationRequest(apphttp.Request{})
+			if !errors.Is(err, failure) {
+				t.Fatalf("expected original error, got %v", err)
+			}
+		})
+	}
+}
+
+func TestRestoreDoesNotRetryDecodedCredentialRejection(t *testing.T) {
+	sut := NewAppStore(Args{DisableAuthenticationRetries: true}).(*appstore)
+	response := apphttp.Result[loginResult]{StatusCode: 200, Data: loginResult{
+		FailureType: FailureTypeInvalidCredentials, CustomerMessage: "invalid credentials",
+	}}
+	retry, _, err := sut.parseLoginResponse(&response, 1, "", testAuthEndpoint)
+	if retry || err == nil {
+		t.Fatalf("credential rejection must stop this attempt: retry=%v, err=%v", retry, err)
+	}
+}
+
+func TestRestoreStillAcceptsStoreRedirectsAndTwoFactorChallenges(t *testing.T) {
+	sut := NewAppStore(Args{DisableAuthenticationRetries: true}).(*appstore)
+	challenge := apphttp.Result[loginResult]{StatusCode: 200, Data: loginResult{
+		CustomerMessage: CustomerMessageBadLogin,
+	}}
+	if retry, _, err := sut.parseLoginResponse(&challenge, 1, "", testAuthEndpoint); retry || !errors.Is(err, ErrAuthCodeRequired) {
+		t.Fatalf("expected explicit 2FA challenge: retry=%v, err=%v", retry, err)
+	}
+	response := apphttp.Result[loginResult]{StatusCode: 302, Headers: map[string]string{"location": testAuthEndpoint}}
+	if retry, target, err := sut.parseLoginResponse(&response, 1, "", testAuthEndpoint); !retry || target != testAuthEndpoint || err != nil {
+		t.Fatalf("expected valid Store redirect: retry=%v, target=%q, err=%v", retry, target, err)
+	}
+}
